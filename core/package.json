{
  "name": "aspect-model-editor",
  "author": "",
  "description": "Used to design and edit SAMM specific aspect models.",
  "productName": "Aspect-Model-Editor",
  "version": "",
  "main": "dist/main.js",
  "repository": {
    "type": "git",
    "url": "https://github.com/eclipse-esmf/esmf-aspect-model-editor.git"
  },
  "build": {
    "appId": "org.eclipse.esmf",
    "artifactName": "${name}-v${version}-${os}.${ext}",
    "win": {
      "target": "zip",
      "icon": "./apps/ame/src/assets/img/png/aspect-model-editor-targetsize-256.png",
      "files": [
        {
          "from": "dist/electron",
          "to": "electron",
          "filter": [
            "**/*",
            "!main/**"
          ]
        },
        {
          "from": "dist",
          "to": "dist",
          "filter": [
            "**/*",
            "!electron/**"
          ]
        },
        {
          "from": "dist",
          "to": ".",
          "filter": [
            "main.js",
            "package.json"
          ]
        }
      ],
      "extraFiles": [
        {
          "from": "../backend/",
          "to": "backend/",
          "filter": [
            "**/*"
          ]
        },
        {
          "from": "./apps/ame/src/assets/aspect-models/com.examples/1.0.0/",
          "to": "default-models/",
          "filter": [
            "**/*"
          ]
        },
        {
          "from": "./apps/ame/src/assets/img/png/app-menu/",
          "to": "app-menu/",
          "filter": [
            "**/*"
          ]
        },
        {
          "from": "./dist/electron/loading-screen/",
          "to": "loading-screen/",
          "filter": [
            "**/*"
          ]
        }
      ]
    },
    "mac": {
      "target": "zip",
      "icon": "./apps/ame/src/assets/img/icns/aspect-model-editor-targetsize-192.icns",
      "files": [
        {
          "from": "dist/electron",
          "to": "electron",
          "filter": [
            "**/*",
            "!main/**"
          ]
        },
        {
          "from": "dist",
          "to": "dist",
          "filter": [
            "**/*",
            "!electron/**"
          ]
        },
        {
          "from": "dist",
          "to": ".",
          "filter": [
            "main.js",
            "package.json"
          ]
        }
      ],
      "extraFiles": [
        {
          "from": "../backend/",
          "to": "backend/",
          "filter": [
            "**/*"
          ]
        },
        {
          "from": "./apps/ame/src/assets/aspect-models/com.examples/1.0.0/",
          "to": "default-models/",
          "filter": [
            "**/*"
          ]
        },
        {
          "from": "./apps/ame/src/assets/img/png/app-menu/",
          "to": "app-menu/",
          "filter": [
            "**/*"
          ]
        },
        {
          "from": "./dist/electron/loading-screen/",
          "to": "loading-screen/",
          "filter": [
            "**/*"
          ]
        }
      ]
    },
    "linux": {
      "target": "tar.gz",
      "icon": "./apps/ame/src/assets/img/icns/aspect-model-editor-targetsize-192.icns",
      "files": [
        {
          "from": "dist/electron",
          "to": "electron",
          "filter": [
            "**/*",
            "!main/**"
          ]
        },
        {
          "from": "dist",
          "to": "dist",
          "filter": [
            "**/*",
            "!electron/**"
          ]
        },
        {
          "from": "dist",
          "to": ".",
          "filter": [
            "main.js",
            "package.json"
          ]
        }
      ],
      "extraFiles": [
        {
          "from": "../backend/",
          "to": "backend/",
          "filter": [
            "**/*"
          ]
        },
        {
          "from": "./apps/ame/src/assets/aspect-models/com.examples/1.0.0/",
          "to": "default-models/",
          "filter": [
            "**/*"
          ]
        },
        {
          "from": "./apps/ame/src/assets/img/png/app-menu/",
          "to": "app-menu/",
          "filter": [
            "**/*"
          ]
        },
        {
          "from": "./dist/electron/loading-screen/",
          "to": "loading-screen/",
          "filter": [
            "**/*"
          ]
        }
      ]
    },
    "directories": {
      "output": "./.electron"
    }
  },
  "scripts": {
    "start": "nx serve",
    "start:electron:mac": "pnpm build:electron && pnpm exec electron . --dev",
    "start:electron:linux": "pnpm build:electron && pnpm exec electron . --dev",
    "start:electron:win": "pnpm build:electron && .\\node_modules\\electron\\dist\\electron.exe . --dev",
    "start:electron:mac:prod": "pnpm build:electron:prod && pnpm exec electron .",
    "start:electron:linux:prod": "pnpm build:electron:prod && pnpm exec electron .",
    "start:electron:win:prod": "pnpm build:electron:prod && pnpm exec .\\node_modules\\electron\\dist\\electron.exe .",
    "build": "nx build",
    "build:prod": "nx build --configuration=production",
    "build:stats": "nx build --configuration=production --stats-json",
    "build:electron": "tsc -p tsconfig.electron.json && shx cp -R ./electron/loading-screen ./dist/electron/",
    "build:electron:prod": "tsc -p tsconfig.electron.prod.json && pnpm electron:minify && pnpm electron:obfuscate && shx mkdir -p ./dist/electron/loading-screen && shx cp ./electron/loading-screen/*.html ./dist/electron/loading-screen/",
    "build:win": "pnpm build:electron && nx build && electron-builder build --win",
    "build:mac": "pnpm build:electron && nx build && electron-builder build --mac",
    "build:linux": "pnpm build:electron && nx build && electron-builder build --linux",
    "build:win:prod": "pnpm build:electron:prod && nx build --configuration=production && electron-builder build --win",
    "build:mac:prod": "pnpm build:electron:prod && nx build --configuration=production && electron-builder build --mac",
    "build:linux:prod": "pnpm build:electron:prod && nx build --configuration=production && electron-builder build --linux",
    "electron:minify": "esbuild dist/electron/**/*.js --minify --platform=node --outdir=dist/electron --legal-comments=none --target=node20 --allow-overwrite",
    "electron:obfuscate": "javascript-obfuscator \"dist/electron\" --output \"dist/electron\" --compact true --self-defending false",
    "lint": "nx run-many --all --target=lint --exclude=ame-e2e",
    "lint:affected": "nx affected:lint --exclude ame-e2e",
    "lint:uncommitted": "nx affected --target=lint --exclude=ame-e2e --uncommitted",
    "test": "nx run-many --all --target=test",
    "test:coverage": "nx run-many --all --target=test --coverage",
    "test:electron": "nx test electron",
    "test:aspect-exporter": "nx test aspect-exporter",
    "test:connection": "nx test connection",
    "test:editor": "nx test editor",
    "test:namespace-manager": "nx test namespace-manager",
    "test:rdf": "nx test rdf",
    "test:settings-dialog": "nx test settings-dialog",
    "test:shared": "nx test shared",
    "test:sidebar": "nx test sidebar",
    "test:utils": "nx test utils",
    "test:affected": "nx affected:test",
    "cypress": "pnpm run cypress:clean && pnpm run cypress:ci",
    "cypress:open": "pnpm run cypress:clean && pnpm dlx cypress open",
    "cypress:ci": "start-server-and-test start http://localhost:4200 cypress:headless",
    "cypress:headless": "cypress run --browser chrome",
    "cypress:clean": "rimraf 'cypress/reports' && rimraf 'coverage'",
    "cypress:cache-clean": "cypress cache clear && cypress install",
    "affected:build": "nx affected:build",
    "affected:e2e": "nx affected:e2e",
    "affected:dep-graph": "nx affected:dep-graph",
    "dep-graph": "nx dep-graph",
    "update": "nx migrate latest",
    "format:check": "prettier --config ./.prettierrc --list-different \"./apps/ame/src/{app,assets}/**/*{.ts,.js,.json,.html,.scss}\" \"./apps/ame-e2e/src/integration/**/*{.ts,.js,.json,.html,.scss}\" \"./libs/**/*{.ts,.js,.json,.html,.scss}\" \"./environments/**/*{.ts,.js,.json,.html,.scss}\"",
    "format": "prettier --config ./.prettierrc --write \"./apps/ame/src/{app,assets}/**/*{.ts,.js,.json,.html,.scss}\" \"./apps/ame-e2e/src/integration/**/*{.ts,.js,.json,.html,.scss}\" \"./libs/**/*{.ts,.js,.json,.html,.scss}\" \"./environments/**/*{.ts,.js,.json,.html,.scss}\"",
    "format:uncommitted": "node ./utils/format-uncommitted.js",
    "doc:app": "compodoc -p apps/ame-e2e/tsconfig.json -t --hideGenerator -d dist/docs/app",
    "license-report": "license-report --only=prod --output=html --department.value=ESMF --relatedTo.value=esmf-aspect-model-editor",
    "prepare": "cd .. && husky install core/.husky"
  },
  "private": true,
  "dependencies": {
    "@angular/cdk": "22.1.3",
    "@angular/common": "22.1.3",
    "@angular/compiler": "22.1.3",
    "@angular/core": "22.1.3",
    "@angular/forms": "22.1.3",
    "@angular/material": "22.1.3",
    "@angular/platform-browser": "22.1.3",
    "@angular/router": "22.1.3",
    "@jsverse/transloco": "^8.4.0",
    "@maxgraph/core": "^0.22.0",
    "file-saver": "^2.0.5",
    "fuse.js": "~6.5.3",
    "locale-codes": "^1.3.1",
    "n3": "~2.6.4",
    "ngx-toastr": "^20.0.5",
    "portfinder": "^1.0.28",
    "rxjs": "7.8.1",
    "tslib": "^2.6.3",
    "typescript-mix": "^3.1.3",
    "urn-lib": "^2.0.0"
  },
