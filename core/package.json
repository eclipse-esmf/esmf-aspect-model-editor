    "@codemirror/view": "6.43.13",
    "@jsverse/transloco": "^8.4.0",
    "@lezer/highlight": "1.2.5",
    "@maxgraph/core": "^0.22.0",
    "@ngrx/signals": "22.0.1",
    "@tauri-apps/api": "~2.11.1",
    "@tauri-apps/plugin-clipboard-manager": "~2.3.3",
    "@tauri-apps/plugin-dialog": "~2.7.3",
