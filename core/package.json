    "angular-eslint": "^22.1.0",
    "esbuild": "^0.28.1",
    "eslint": "^10.9.1",
    "eslint-config-prettier": "10.1.8",
    "husky": "^8.0.3",
    "javascript-obfuscator": "^5.3.0",
    "jsdom": "30.0.1",
    "license-report": "^6.3.0",
    "ng-mocks": "^14.11.0",
    "ng-packagr": "20.2.0",
    "nx": "23.1.1",
    "prettier": "^3.2.5",
    "prettier-plugin-organize-attributes": "^1.0.0",
    "prettier-plugin-organize-imports": "^4.1.0",
