{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "Aspect Model Editor",
  "version": "0.0.1",
  "identifier": "org.eclipse.esmf.ame",
  "build": {
    "frontendDist": "../dist/apps/ame",
    "devUrl": "http://localhost:4200",
    "beforeDevCommand": "pnpm start",
    "beforeBuildCommand": "pnpm build:prod"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Aspect Model Editor",
        "width": 1280,
        "height": 800,
        "minWidth": 800,
        "minHeight": 600,
        "resizable": true,
        "fullscreen": false,
        "visible": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob: asset: http://asset.localhost; font-src 'self' data:; connect-src 'self' ipc: http://ipc.localhost http://localhost:* http://127.0.0.1:*; worker-src 'self' blob:; object-src 'none'; base-uri 'self'; form-action 'none'",
      "dangerousDisableAssetCspModification": ["style-src"]
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.icns", "icons/icon.ico"],
    "resources": {
      "../apps/ame/src/assets/aspect-models/com.examples/1.0.0/": "assets/aspect-models/com.examples/1.0.0/"
    }
  }
}
