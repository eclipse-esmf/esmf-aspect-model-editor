{
  "compileOnSave": false,
  "compilerOptions": {
    "rootDir": ".",
    "resolveJsonModule": true,
    "sourceMap": true,
    "declaration": false,
    "moduleResolution": "bundler",
    "emitDecoratorMetadata": true,
    "experimentalDecorators": true,
    "importHelpers": true,
    "target": "ES2022",
    "module": "esnext",
    "skipLibCheck": true,
    "skipDefaultLibCheck": true,
    "baseUrl": ".",
    "forceConsistentCasingInFileNames": true,
    "strict": true,
    "noImplicitReturns": false,
    "noFallthroughCasesInSwitch": true,
    "noImplicitAny": false,
    "ignoreDeprecations": "6.0",
    "strictNullChecks": false,
    "esModuleInterop": true,
    "paths": {
      "@ame/domain": ["libs/domain/src/index.ts"],
      "@ame/editor": ["libs/editor/src/index.ts"],
      "@ame/editor/tabs": ["libs/editor/src/lib/tabs/index.ts"],
      "@ame/graph": ["libs/graph/src/index.ts"],
      "@ame/infrastructure": ["libs/infrastructure/src/index.ts"],
      "@ame/search": ["libs/search/src/index.ts"],
      "@ame/settings": ["libs/settings/src/index.ts"],
      "@ame/shared": ["libs/shared/src/index.ts"],
      "@ame/sidebar": ["libs/sidebar/src/index.ts"],
      "@ame/workbench": ["libs/workbench/src/index.ts"],
      "@ame/esmf": ["libs/esmf/src/index.ts"],
      "@esmf/aspect-model-loader": ["libs/esmf/src/index.ts"]
    },
    "typeRoots": ["node_modules/@types"],
    "lib": ["es2018", "dom"],
    "noUncheckedSideEffectImports": false,
    "types": ["*"]
  },
  "exclude": ["node_modules", "tmp"]
}
