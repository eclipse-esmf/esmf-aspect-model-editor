{
  "compileOnSave": false,
  "compilerOptions": {
    "rootDir": ".",
    "resolveJsonModule": true,
    "sourceMap": true,
    "declaration": false,
    "moduleResolution": "bundler",
    "emitDecoratorMetadata": true,
    "experimentalDecorators": true,
    "importHelpers": true,
    "target": "ES2022",
    "module": "esnext",
    "skipLibCheck": true,
    "skipDefaultLibCheck": true,
    "baseUrl": ".",
    "forceConsistentCasingInFileNames": true,
    "strict": true,
    "noImplicitReturns": false,
    "noFallthroughCasesInSwitch": true,
    "noImplicitAny": false,
    "ignoreDeprecations": "6.0",
    "strictNullChecks": false,
    "esModuleInterop": true,
    "paths": {
      "@ame/api": ["libs/infrastructure/src/index.ts"],
      "@ame/app/*": ["apps/ame/src/app/*"],
      "@ame/aspect-exporter": ["libs/samm/src/index.ts"],
      "@ame/cache": ["libs/infrastructure/src/index.ts"],
      "@ame/connection": ["libs/graph/src/index.ts"],
      "@ame/contracts": ["libs/shared/src/index.ts"],
      "@ame/domain": ["libs/domain/src/index.ts"],
      "@ame/editor": ["libs/features/src/index.ts"],
      "@ame/features": ["libs/features/src/index.ts"],
      "@ame/graph": ["libs/graph/src/index.ts"],
      "@ame/infrastructure": ["libs/infrastructure/src/index.ts"],
      "@ame/instantiator": ["libs/samm/src/index.ts"],
      "@ame/loader-filters": ["libs/domain/src/index.ts"],
      "@ame/meta-model": ["libs/domain/src/index.ts"],
      "@ame/max-graph": ["libs/graph/src/index.ts"],
      "@ame/namespace-manager": ["libs/samm/src/index.ts"],
      "@ame/rdf": ["libs/infrastructure/src/index.ts"],
      "@ame/samm": ["libs/samm/src/index.ts"],
      "@ame/settings-dialog": ["libs/features/src/index.ts"],
      "@ame/shared": ["libs/shared/src/index.ts"],
      "@ame/sidebar": ["libs/features/src/index.ts"],
      "@ame/testing": ["libs/shared/src/index.ts"],
      "@ame/translation": ["libs/shared/src/index.ts"],
      "@ame/utils": ["libs/shared/src/index.ts"],
      "@ame/esmf": ["libs/esmf/src/index.ts"],
      "@esmf/aspect-model-loader": ["libs/esmf/src/index.ts"]
    },
    "typeRoots": ["node_modules/@types"],
    "lib": ["es2018", "dom"],
    "noUncheckedSideEffectImports": false,
    "types": ["*"]
  },
  "exclude": ["node_modules", "tmp"]
}
