# Create symlinks to dependencies instead of copying them (faster, less disk usage)
symlink=true

# Do not prefix package versions with ^ (caret) or ~ (tilde) when saving — exact version only
save-prefix=

# Minimum age (in days) a package must have in the registry before pnpm will download it (security policy)
min-release-age=7

# Do not allow installation of packages with exotic subdependencies (security policy)
block-exotic-subdeps=false

# Allow pnpm to link local workspace packages directly instead of installing from registry
link-workspace-packages=true

# Do not run lifecycle scripts on install (supply-chain policy)
ignore-scripts=true

# Use a single pnpm-lock.yaml file at the workspace root instead of per-package lock files
shared-workspace-lockfile=true

# When resolving dependencies, prefer packages from the local workspace over npm registry
prefer-workspace-packages=true

# When saving dependencies, store the workspace protocol prefix (workspace:*) in package.json
save-workspace-protocol=true

# Use isolated node linker mode: each package gets its own node_modules/.pnpm folder — prevents version conflicts
# and mixed webpack instances that cause "DefinePlugin compilation must be Compilation" errors
node-linker=isolated

# Avoids aggressive dependency flattening
shamefully-hoist=false
