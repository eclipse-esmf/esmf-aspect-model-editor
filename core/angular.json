{
  "$schema": "./node_modules/@angular/cli/lib/config/schema.json",
  "version": 1,
  "newProjectRoot": "libs",
  "projects": {
    "ame": {
      "projectType": "application",
      "root": "apps/ame",
      "sourceRoot": "apps/ame/src",
      "prefix": "ame",
      "architect": {
        "build": {
          "builder": "@angular/build:application",
          "options": {
            "outputPath": {
              "base": "dist/apps/ame",
              "browser": ""
            },
            "index": "apps/ame/src/index.html",
            "browser": "apps/ame/src/main.ts",
            "polyfills": [],
            "tsConfig": "apps/ame/tsconfig.app.json",
            "inlineStyleLanguage": "scss",
            "assets": ["apps/ame/src/assets"],
            "styles": ["node_modules/ngx-toastr/toastr.css", "apps/ame/src/styles.scss"],
            "scripts": ["apps/ame/src/assets/samm-units.js"]
          },
          "configurations": {
            "production": {
              "fileReplacements": [{"replace": "environments/environment.ts", "with": "environments/environment.prod.ts"}],
              "outputHashing": "all"
            },
            "development": {
              "optimization": false,
              "extractLicenses": true,
              "sourceMap": true,
              "namedChunks": true
            }
          },
          "defaultConfiguration": "production"
        },
        "serve": {
          "builder": "@angular/build:dev-server",
          "defaultConfiguration": "development",
          "configurations": {
            "production": {
              "buildTarget": "ame:build:production"
            },
            "development": {
              "buildTarget": "ame:build:development"
            }
          }
        },
        "serve-coverage": {
          "builder": "@angular/build:dev-server",
          "defaultConfiguration": "development",
          "configurations": {
            "production": {
              "buildTarget": "ame:build:production"
            },
            "development": {
              "buildTarget": "ame:build:development"
            }
          }
        },
        "extract-i18n": {
          "builder": "@angular/build:extract-i18n",
          "options": {
            "buildTarget": "ame:build"
          }
        },
        "test": {
          "builder": "@angular/build:unit-test",
          "options": {
            "tsConfig": "apps/ame/tsconfig.spec.json",
            "buildTarget": "ame:build:development"
          }
        }
      }
    }
  }
}
