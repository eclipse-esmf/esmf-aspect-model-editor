  "projectType": "library",
  "tags": ["scope:esmf", "layer:esmf"],
  "targets": {
    "test": {
      "executor": "@angular/build:unit-test",
      "outputs": ["{workspaceRoot}/coverage/libs/esmf"],
      "options": {
