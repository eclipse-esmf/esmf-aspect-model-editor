{
  "name": "instantiator",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "projectType": "library",
  "sourceRoot": "libs/instantiator/src",
  "prefix": "ame",
  "targets": {
    "test": {
      "executor": "@angular/build:unit-test",
      "outputs": ["{workspaceRoot}/coverage/libs/instantiator"],
      "options": {
        "tsConfig": "libs/instantiator/tsconfig.spec.json",
        "buildTarget": "instantiator:build",
        "watch": false
      }
    },
    "lint": {
      "executor": "@nx/eslint:lint"
    },
    "build": {
      "executor": "@angular/build:ng-packagr",
      "outputs": ["{workspaceRoot}/dist/libs/instantiator"],
      "options": {
        "project": "libs/instantiator/ng-package.json"
      },
      "dependsOn": []
    }
  }
}
