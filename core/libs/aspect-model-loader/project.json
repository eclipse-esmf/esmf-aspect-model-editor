{
  "name": "aspect-model-loader",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "libs/aspect-model-loader/src",
  "prefix": "lib",
  "projectType": "library",
  "tags": [],
  "targets": {
    "test": {
      "executor": "@angular/build:unit-test",
      "outputs": ["{workspaceRoot}/coverage/libs/aspect-model-loader"],
      "options": {
        "tsConfig": "libs/aspect-model-loader/tsconfig.spec.json",
        "buildTarget": "aspect-model-loader:build",
        "watch": false
      }
    },
    "lint": {
      "executor": "@nx/eslint:lint"
    },
    "build": {
      "executor": "@angular/build:ng-packagr",
      "outputs": ["{workspaceRoot}/dist/libs/aspect-model-loader"],
      "options": {
        "project": "libs/aspect-model-loader/ng-package.json"
      },
      "dependsOn": []
    }
  }
}
