{
  "name": "rdf",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "projectType": "library",
  "sourceRoot": "libs/rdf/src",
  "prefix": "ame",
  "targets": {
    "test": {
      "executor": "@angular/build:unit-test",
      "outputs": ["{workspaceRoot}/coverage/libs/rdf"],
      "options": {
        "tsConfig": "libs/rdf/tsconfig.spec.json",
        "buildTarget": "rdf:build",
        "watch": false
      }
    },
    "lint": {
      "executor": "@nx/eslint:lint"
    },
    "build": {
      "executor": "@angular/build:ng-packagr",
      "outputs": ["{workspaceRoot}/dist/libs/rdf"],
      "options": {
        "project": "libs/rdf/ng-package.json"
      },
      "dependsOn": []
    }
  }
}
